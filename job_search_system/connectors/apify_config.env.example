# Copy this to apify_config.local.env, your user environment, or PowerShell profile.
# Do not commit real tokens.

# Required for Apify API access.
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Preferred: run an Actor automatically each refresh.
# Use either APIFY_ACTOR_ID or APIFY_TASK_ID.
# Actor IDs look like username/actor-name or username~actor-name.
APIFY_ACTOR_ID=
APIFY_TASK_ID=

# Optional: read an existing dataset instead of running an Actor.
APIFY_DATASET_ID=

# Optional: custom actor input JSON file.
APIFY_INPUT_FILE=job_search_system/connectors/apify_linkedin_data_analyst_input.json

# Optional: how long to wait for a synchronous Actor run.
APIFY_RUN_TIMEOUT_SECONDS=300
